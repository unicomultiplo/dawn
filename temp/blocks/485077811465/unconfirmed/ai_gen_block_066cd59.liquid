{% doc %}
  @prompt
    un banner accattivante ch introduca a pulsanti sui contenuti che ho per il natale: idee regalo, pagina natale 26 e pagina la tavola di natale
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-natale-banner-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    box-sizing: border-box;
    padding: clamp(28px, 5vw, 64px) 24px;
    color: {{ block.settings.text_color }};
    background-color: {{ block.settings.background_color }};
    text-align: center;
  }

  .ai-natale-banner-{{ ai_gen_id }}__inner {
    width: 100%;
    max-width: 1050px;
    margin: 0 auto;
  }

  .ai-natale-banner-{{ ai_gen_id }}__eyebrow {
    margin: 0 0 12px;
    color: {{ block.settings.accent_color }};
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .ai-natale-banner-{{ ai_gen_id }}__title {
    margin: 0 auto 14px;
    max-width: 780px;
    color: inherit;
    font-size: clamp(30px, 5vw, 54px);
    line-height: 1.08;
  }

  .ai-natale-banner-{{ ai_gen_id }}__intro {
    max-width: 650px;
    margin: 0 auto 28px;
    font-size: 16px;
    line-height: 1.6;
  }

  .ai-natale-banner-{{ ai_gen_id }}__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }

  .ai-natale-banner-{{ ai_gen_id }}__link {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    padding: 12px 22px;
    border: 1px solid {{ block.settings.button_color }};
    background: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    font-size: 14px;
    font-weight: 600;
    line-height: 1.25;
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .ai-natale-banner-{{ ai_gen_id }}__link:hover {
    background: transparent;
    color: {{ block.settings.text_color }};
  }

  .ai-natale-banner-{{ ai_gen_id }}__link:focus-visible {
    outline: 2px solid {{ block.settings.accent_color }};
    outline-offset: 4px;
  }

  @media screen and (max-width: 600px) {
    .ai-natale-banner-{{ ai_gen_id }} {
      padding-right: 18px;
      padding-left: 18px;
    }

    .ai-natale-banner-{{ ai_gen_id }}__links {
      flex-direction: column;
      align-items: stretch;
    }

    .ai-natale-banner-{{ ai_gen_id }}__link {
      width: 100%;
    }
  }
{% endstyle %}

<div class="ai-natale-banner-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-natale-banner-{{ ai_gen_id }}__inner">
    {% if block.settings.eyebrow != blank %}
      <p class="ai-natale-banner-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow | escape }}</p>
    {% endif %}
    {% if block.settings.heading != blank %}
      <h2 class="ai-natale-banner-{{ ai_gen_id }}__title">{{ block.settings.heading | escape }}</h2>
    {% endif %}
    {% if block.settings.intro != blank %}
      <div class="ai-natale-banner-{{ ai_gen_id }}__intro">{{ block.settings.intro }}</div>
    {% endif %}
    <nav class="ai-natale-banner-{{ ai_gen_id }}__links" aria-label="Contenuti natalizi">
      {% if block.settings.gift_url != blank %}
        <a class="ai-natale-banner-{{ ai_gen_id }}__link" href="{{ block.settings.gift_url }}">{{ block.settings.gift_label | escape }}</a>
      {% endif %}
      {% if block.settings.christmas_url != blank %}
        <a class="ai-natale-banner-{{ ai_gen_id }}__link" href="{{ block.settings.christmas_url }}">{{ block.settings.christmas_label | escape }}</a>
      {% endif %}
      {% if block.settings.table_url != blank %}
        <a class="ai-natale-banner-{{ ai_gen_id }}__link" href="{{ block.settings.table_url }}">{{ block.settings.table_label | escape }}</a>
      {% endif %}
    </nav>
  </div>
</div>

{% schema %}
{
  "name": "Banner Natale",
  "settings": [
    { "type": "range", "id": "desktop_width_percent", "label": "Larghezza desktop", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "text", "id": "eyebrow", "label": "Sopratitolo", "default": "Il Natale prende forma" },
    { "type": "text", "id": "heading", "label": "Titolo", "default": "Idee e ispirazioni per un Natale speciale" },
    { "type": "richtext", "id": "intro", "label": "Testo introduttivo", "default": "<p>Scopri le nostre proposte per sorprendere chi ami e rendere unica la tavola delle feste.</p>" },
    { "type": "header", "content": "Pulsanti" },
    { "type": "text", "id": "gift_label", "label": "Testo: idee regalo", "default": "Idee regalo" },
    { "type": "url", "id": "gift_url", "label": "Link: idee regalo" },
    { "type": "text", "id": "christmas_label", "label": "Testo: pagina Natale", "default": "Natale 26" },
    { "type": "url", "id": "christmas_url", "label": "Link: pagina Natale" },
    { "type": "text", "id": "table_label", "label": "Testo: tavola di Natale", "default": "La tavola di Natale" },
    { "type": "url", "id": "table_url", "label": "Link: tavola di Natale" },
    { "type": "header", "content": "Stile" },
    { "type": "color", "id": "background_color", "label": "Sfondo", "default": "#F4F1EC" },
    { "type": "color", "id": "text_color", "label": "Testo", "default": "#242833" },
    { "type": "color", "id": "accent_color", "label": "Accento", "default": "#7A342D" },
    { "type": "color", "id": "button_color", "label": "Pulsanti", "default": "#242833" },
    { "type": "color", "id": "button_text_color", "label": "Testo pulsanti", "default": "#FFFFFF" }
  ],
  "presets": [
    { "name": "Banner Natale" }
  ],
  "tag": null,
  "class": "natale-banner-block"
}
{% endschema %}