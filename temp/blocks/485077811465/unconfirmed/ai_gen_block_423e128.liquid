{% doc %}
  @prompt
    un banner accattivante ch introduca a pulsanti sui contenuti che ho per il natale: idee regalo, pagina natale 26 e pagina la tavola di natale, non mi piace, metti magari immagine ferma che scorre coi blocchi, e i pulsanti che ti ho indicatp
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-natale-hero-{{ ai_gen_id }} {
    display: block;
    position: relative;
    overflow: hidden;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    min-height: 420px;
    color: {{ block.settings.text_color }};
    background-color: {{ block.settings.fallback_color }};
  }

  .ai-natale-hero-{{ ai_gen_id }}__media,
  .ai-natale-hero-{{ ai_gen_id }}__media img,
  .ai-natale-hero-{{ ai_gen_id }}__placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .ai-natale-hero-{{ ai_gen_id }}__media img {
    display: block;
    object-fit: cover;
    object-position: center;
  }

  .ai-natale-hero-{{ ai_gen_id }}__placeholder svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: {{ block.settings.fallback_color }};
  }

  .ai-natale-hero-{{ ai_gen_id }}__shade {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, {{ block.settings.overlay_opacity | divided_by: 100.0 }});
  }

  .ai-natale-hero-{{ ai_gen_id }}__content {
    position: relative;
    z-index: 1;
    display: flex;
    min-height: 420px;
    box-sizing: border-box;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 56px 24px;
    text-align: center;
  }

  .ai-natale-hero-{{ ai_gen_id }}__eyebrow {
    margin: 0 0 12px;
    color: {{ block.settings.accent_color }};
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .ai-natale-hero-{{ ai_gen_id }}__title {
    max-width: 800px;
    margin: 0 0 16px;
    color: {{ block.settings.text_color }};
    font-size: clamp(34px, 5vw, 60px);
    line-height: 1.08;
  }

  .ai-natale-hero-{{ ai_gen_id }}__copy {
    max-width: 640px;
    margin-bottom: 28px;
    color: {{ block.settings.text_color }};
    font-size: 17px;
    line-height: 1.6;
  }

  .ai-natale-hero-{{ ai_gen_id }}__copy p {
    margin: 0;
  }

  .ai-natale-hero-{{ ai_gen_id }}__buttons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }

  .ai-natale-hero-{{ ai_gen_id }}__button {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    padding: 12px 22px;
    border: 1px solid {{ block.settings.button_color }};
    background: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    font-size: 14px;
    font-weight: 600;
    line-height: 1.25;
    text-decoration: none;
  }

  .ai-natale-hero-{{ ai_gen_id }}__button:hover {
    background: {{ block.settings.button_hover_color }};
    border-color: {{ block.settings.button_hover_color }};
    color: {{ block.settings.button_hover_text_color }};
  }

  .ai-natale-hero-{{ ai_gen_id }}__button:focus-visible {
    outline: 2px solid {{ block.settings.accent_color }};
    outline-offset: 4px;
  }

  @media screen and (max-width: 600px) {
    .ai-natale-hero-{{ ai_gen_id }},
    .ai-natale-hero-{{ ai_gen_id }}__content {
      min-height: 480px;
    }

    .ai-natale-hero-{{ ai_gen_id }}__content {
      padding: 44px 18px;
    }

    .ai-natale-hero-{{ ai_gen_id }}__buttons {
      width: 100%;
      flex-direction: column;
      align-items: stretch;
    }

    .ai-natale-hero-{{ ai_gen_id }}__button {
      width: 100%;
    }
  }
{% endstyle %}

<div class="ai-natale-hero-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-natale-hero-{{ ai_gen_id }}__media">
    {% if block.settings.image != blank %}
      <img src="{{ block.settings.image | image_url: width: 2400 }}" alt="{{ block.settings.image.alt | escape }}" loading="lazy" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}">
    {% else %}
      <div class="ai-natale-hero-{{ ai_gen_id }}__placeholder">
        {{ 'image' | placeholder_svg_tag }}
      </div>
    {% endif %}
  </div>
  <div class="ai-natale-hero-{{ ai_gen_id }}__shade" aria-hidden="true"></div>
  <div class="ai-natale-hero-{{ ai_gen_id }}__content">
    {% if block.settings.eyebrow != blank %}<p class="ai-natale-hero-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow | escape }}</p>{% endif %}
    {% if block.settings.heading != blank %}<h2 class="ai-natale-hero-{{ ai_gen_id }}__title">{{ block.settings.heading | escape }}</h2>{% endif %}
    {% if block.settings.copy != blank %}<div class="ai-natale-hero-{{ ai_gen_id }}__copy">{{ block.settings.copy }}</div>{% endif %}
    <nav class="ai-natale-hero-{{ ai_gen_id }}__buttons" aria-label="Contenuti di Natale">
      {% if block.settings.gift_url != blank %}<a class="ai-natale-hero-{{ ai_gen_id }}__button" href="{{ block.settings.gift_url }}">{{ block.settings.gift_label | escape }}</a>{% endif %}
      {% if block.settings.christmas_url != blank %}<a class="ai-natale-hero-{{ ai_gen_id }}__button" href="{{ block.settings.christmas_url }}">{{ block.settings.christmas_label | escape }}</a>{% endif %}
      {% if block.settings.table_url != blank %}<a class="ai-natale-hero-{{ ai_gen_id }}__button" href="{{ block.settings.table_url }}">{{ block.settings.table_label | escape }}</a>{% endif %}
    </nav>
  </div>
</div>

{% schema %}
{
  "name": "Hero Natale",
  "settings": [
    { "type": "range", "id": "desktop_width_percent", "label": "Larghezza desktop", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "image_picker", "id": "image", "label": "Immagine" },
    { "type": "range", "id": "overlay_opacity", "label": "Ombreggiatura immagine", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 40 },
    { "type": "text", "id": "eyebrow", "label": "Sopratitolo", "default": "Il Natale prende forma" },
    { "type": "text", "id": "heading", "label": "Titolo", "default": "Un Natale da vivere insieme" },
    { "type": "richtext", "id": "copy", "label": "Testo introduttivo", "default": "<p>Idee, ispirazioni e dettagli speciali per i tuoi regali e la tavola delle feste.</p>" },
    { "type": "header", "content": "Pulsanti e link" },
    { "type": "text", "id": "gift_label", "label": "Testo pulsante", "default": "Idee regalo" },
    { "type": "url", "id": "gift_url", "label": "Link idee regalo" },
    { "type": "text", "id": "christmas_label", "label": "Testo pulsante", "default": "Natale 26" },
    { "type": "url", "id": "christmas_url", "label": "Link pagina Natale 26" },
    { "type": "text", "id": "table_label", "label": "Testo pulsante", "default": "La tavola di Natale" },
    { "type": "url", "id": "table_url", "label": "Link tavola di Natale" },
    { "type": "header", "content": "Colori" },
    { "type": "color", "id": "fallback_color", "label": "Sfondo senza immagine", "default": "#242833" },
    { "type": "color", "id": "text_color", "label": "Testo", "default": "#FFFFFF" },
    { "type": "color", "id": "accent_color", "label": "Accento", "default": "#F4CF5F" },
    { "type": "color", "id": "button_color", "label": "Sfondo pulsanti", "default": "#242833" },
    { "type": "color", "id": "button_text_color", "label": "Testo pulsanti", "default": "#FFFFFF" },
    { "type": "color", "id": "button_hover_color", "label": "Sfondo pulsanti al passaggio", "default": "#7A342D" },
    { "type": "color", "id": "button_hover_text_color", "label": "Testo pulsanti al passaggio", "default": "#FFFFFF" }
  ],
  "presets": [
    { "name": "Hero Natale" }
  ],
  "tag": null,
  "class": "natale-hero-block"
}
{% endschema %}