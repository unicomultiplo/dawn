{% doc %}
  @prompt
    mi serve un rimando al metaobject designer e metafield in prodotto custom.approfondimentodesigner. 
    
    voglio che abbiam struttura: immagine a destra, testo a sinistra con possibilità di aumentare e dimnuire le grandezze dei 2 elementi( p e image). nome designer h2 testo i p pulsante con possibilità di secegliere tema colore e stile e possibilità di agiiungere un pulsante inpiù. con questo articolo 9231791784201 trovi il desiger metaobject e prootto inseriti. imosrtante che sia page with e coerente conil tema del sito., devi mettere: come primo pulsante l 'url che trovi nel metaobject, sotto al titolo, come paragrafo la bio e  coe immagine la foto  che trovi nel metaobject Designer
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% liquid
  assign designer_metaobject = product.metafields.custom.approfondimentodesigner.value
%}

{% style %}
  .ai-designer-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    max-width: {{ settings.page_width }}px;
    margin: 0 auto;
    padding: {{ block.settings.section_padding_top }}px {{ block.settings.section_padding_horizontal }}px {{ block.settings.section_padding_bottom }}px;
  }

  .ai-designer-container-{{ ai_gen_id }} {
    display: flex;
    flex-direction: row-reverse;
    gap: {{ block.settings.gap }}px;
    align-items: {{ block.settings.vertical_alignment }};
    width: 100%;
  }

  .ai-designer-image-wrapper-{{ ai_gen_id }} {
    flex: 0 0 {{ block.settings.image_width }}%;
    max-width: {{ block.settings.image_width }}%;
  }

  .ai-designer-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    border-radius: {{ settings.media_radius }}px;
    border: {{ settings.media_border_thickness }}px solid rgba({{ block.settings.image_border_color.red }}, {{ block.settings.image_border_color.green }}, {{ block.settings.image_border_color.blue }}, {{ settings.media_border_opacity | divided_by: 100.0 }});
  }

  .ai-designer-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1 / 1;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ settings.media_radius }}px;
  }

  .ai-designer-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-designer-content-{{ ai_gen_id }} {
    flex: 0 0 {{ 100 | minus: block.settings.image_width }}%;
    max-width: {{ 100 | minus: block.settings.image_width }}%;
  }

  .ai-designer-name-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 {{ block.settings.text_spacing }}px;
    color: {{ block.settings.text_color }};
    font-weight: 600;
  }

  .ai-designer-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.6;
    margin: 0 0 {{ block.settings.text_spacing }}px;
    color: {{ block.settings.text_color }};
  }

  .ai-designer-buttons-{{ ai_gen_id }} {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: {{ block.settings.button_spacing }}px;
  }

  .ai-designer-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    font-size: {{ block.settings.button_text_size }}px;
    text-decoration: none;
    border-radius: {{ settings.buttons_radius }}px;
    border: {{ settings.buttons_border_thickness }}px solid;
    transition: all 0.3s ease;
    cursor: pointer;
  }

  .ai-designer-button-primary-{{ ai_gen_id }} {
    background-color: {{ block.settings.button_primary_bg }};
    color: {{ block.settings.button_primary_color }};
    border-color: {{ block.settings.button_primary_bg }};
  }

  .ai-designer-button-primary-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_primary_bg | color_darken: 10 }};
    border-color: {{ block.settings.button_primary_bg | color_darken: 10 }};
  }

  .ai-designer-button-secondary-{{ ai_gen_id }} {
    background-color: {{ block.settings.button_secondary_bg }};
    color: {{ block.settings.button_secondary_color }};
    border-color: {{ block.settings.button_secondary_border }};
  }

  .ai-designer-button-secondary-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_secondary_bg | color_darken: 5 }};
    border-color: {{ block.settings.button_secondary_border | color_darken: 10 }};
  }

  .ai-designer-empty-state-{{ ai_gen_id }} {
    padding: 40px;
    text-align: center;
    background-color: #f9f9f9;
    border-radius: {{ settings.media_radius }}px;
    color: #666;
  }

  @media screen and (max-width: 749px) {
    .ai-designer-container-{{ ai_gen_id }} {
      flex-direction: column;
    }

    .ai-designer-image-wrapper-{{ ai_gen_id }},
    .ai-designer-content-{{ ai_gen_id }} {
      flex: 0 0 100%;
      max-width: 100%;
    }

    .ai-designer-section-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.7 }}px {{ block.settings.section_padding_horizontal | times: 0.7 }}px {{ block.settings.section_padding_bottom | times: 0.7 }}px;
    }

    .ai-designer-name-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-designer-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<designer-info-{{ ai_gen_id }} class="ai-designer-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if designer_metaobject %}
    <div class="ai-designer-container-{{ ai_gen_id }}">
      <div class="ai-designer-image-wrapper-{{ ai_gen_id }}">
        {% if designer_metaobject.foto.value %}
          <img
            src="{{ designer_metaobject.foto.value | image_url: width: 800 }}"
            alt="{{ designer_metaobject.nome | escape }}"
            loading="lazy"
            width="800"
            height="800"
            class="ai-designer-image-{{ ai_gen_id }}"
          >
        {% else %}
          <div class="ai-designer-image-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>

      <div class="ai-designer-content-{{ ai_gen_id }}">
        {% if designer_metaobject.nome %}
         <span style="display: block; font-size: 0.68rem; letter-spacing: 0.18em; text-transform: uppercase; color: {{ block.settings.text_color }}; opacity: 0.5; margin-bottom: 8px;">Scopri il Designer</span>
         <h2 class="ai-designer-name-{{ ai_gen_id }}">{{ designer_metaobject.nome }}</h2>
        {% endif %}

        {% if designer_metaobject.bio %}
          <div class="ai-designer-description-{{ ai_gen_id }}">
            {{ designer_metaobject.bio }}
          </div>
        {% endif %}

        <div class="ai-designer-buttons-{{ ai_gen_id }}">
          {% if designer_metaobject.url_profilo.value %}
            <a
              href="{{ designer_metaobject.url_profilo.value }}"
              class="ai-designer-button-{{ ai_gen_id }} ai-designer-button-primary-{{ ai_gen_id }}"
            >
              {{ block.settings.button_primary_label }}
            </a>
          {% endif %}

          {% if block.settings.show_secondary_button and block.settings.button_secondary_label != blank %}
            <a
              href="{{ block.settings.button_secondary_link | default: '#' }}"
              class="ai-designer-button-{{ ai_gen_id }} ai-designer-button-secondary-{{ ai_gen_id }}"
            >
              {{ block.settings.button_secondary_label }}
            </a>
          {% endif %}
        </div>
      </div>
    </div>
  {% endif %}
</designer-info-{{ ai_gen_id }}>

<script>
  (function() {
    class DesignerInfo{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.style.display = 'block';
      }
    }

    customElements.define('designer-info-{{ ai_gen_id }}', DesignerInfo{{ ai_gen_id }});
  })();
</script>

