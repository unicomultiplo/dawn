# Copy to `.env` (gitignored). All values are optional.
#
# The npm scripts load `.env` automatically via node's --env-file-if-exists,
# so nothing needs to be exported in your shell.

# Theme Access token — makes every CLI command fully non-interactive (no browser
# OAuth). Needed for CI, and useful for agents running without a cached session.
# Generate one per collaborator in the store's "Theme Access" app:
# Shopify admin -> Apps -> Theme Access -> Add user -> emailed token (shptka_...)
# SHOPIFY_CLI_THEME_TOKEN=shptka_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Storefront password, if the store is ever put behind a password.
# SHOPIFY_CLI_THEME_STOREFRONT_PASSWORD=

# Override the store from shopify.theme.toml without editing it.
# SHOPIFY_FLAG_STORE=a1cd90-81.myshopify.com

# Opt out of CLI usage analytics.
# SHOPIFY_CLI_NO_ANALYTICS=1
