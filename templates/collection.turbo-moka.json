    "custom_liquid_dhfTYE": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{% comment %}\n  Turbo Moka – Guida alla scelta\n  Desktop: 3 riquadri + tabella comparativa\n  Smartphone: solo i 3 riquadri, senza duplicazioni\n  Prezzi e disponibilità vengono letti automaticamente da Shopify.\n{% endcomment %}\n\n{% assign turbo_1 = all_products['turbo-moka-caffettiera-1-tazza'] %}\n{% assign turbo_3 = all_products['turbo-moka-caffettiera-3-tazze'] %}\n{% assign turbo_6 = all_products['turbo-moka-caffettiera-6-tazze'] %}\n\n<section class=\"tm-choice\">\n\n  <header class=\"tm-choice__header\">\n    <h2>Quale Turbo Moka scegliere?</h2>\n    <p>\n      Confronta i formati da 1, 3 e 6 tazze e scegli quello più adatto\n      alle tue abitudini quotidiane.\n    </p>\n  </header>\n\n  <div class=\"tm-choice__cards\">\n\n    {% if turbo_1 != blank %}\n      <article class=\"tm-choice__card\">\n        <h3>\n          <a href=\"{{ turbo_1.url }}\">Turbo Moka – 1 tazza</a>\n        </h3>\n\n        <p class=\"tm-choice__description\">\n          Ideale per preparare un caffè individuale, a casa o in ufficio.\n        </p>\n\n        <div class=\"tm-choice__bottom\">\n          <div class=\"tm-choice__price\">\n            {% if turbo_1.compare_at_price_max > turbo_1.price %}\n              <span class=\"tm-choice__old-price\">\n                {{ turbo_1.compare_at_price_max | money_with_currency }}\n              </span>\n            {% endif %}\n            <strong>{{ turbo_1.price | money_with_currency }}</strong>\n          </div>\n\n          <p class=\"tm-choice__availability\">\n            {% if turbo_1.available %}\n              <span class=\"tm-choice__available\">Disponibile</span>\n            {% else %}\n              <span class=\"tm-choice__unavailable\">Non disponibile</span>\n            {% endif %}\n          </p>\n\n          <a\n            class=\"tm-choice__link\"\n            href=\"{{ turbo_1.url }}\"\n            aria-label=\"Scopri la Turbo Moka da 1 tazza\"\n          >\n            Scopri la 1 tazza →\n          </a>\n        </div>\n      </article>\n    {% endif %}\n\n    {% if turbo_3 != blank %}\n      <article class=\"tm-choice__card tm-choice__card--featured\">\n        <span class=\"tm-choice__badge\">Formato più scelto</span>\n\n        <h3>\n          <a href=\"{{ turbo_3.url }}\">Turbo Moka – 3 tazze</a>\n        </h3>\n\n        <p class=\"tm-choice__description\">\n          Il formato più versatile per l’uso quotidiano e per preparare\n          più tazzine nello stesso momento.\n        </p>\n\n        <div class=\"tm-choice__bottom\">\n          <div class=\"tm-choice__price\">\n            {% if turbo_3.compare_at_price_max > turbo_3.price %}\n              <span class=\"tm-choice__old-price\">\n                {{ turbo_3.compare_at_price_max | money_with_currency }}\n              </span>\n            {% endif %}\n            <strong>{{ turbo_3.price | money_with_currency }}</strong>\n          </div>\n\n          <p class=\"tm-choice__availability\">\n            {% if turbo_3.available %}\n              <span class=\"tm-choice__available\">Disponibile</span>\n            {% else %}\n              <span class=\"tm-choice__unavailable\">Non disponibile</span>\n            {% endif %}\n          </p>\n\n          <a\n            class=\"tm-choice__link\"\n            href=\"{{ turbo_3.url }}\"\n            aria-label=\"Scopri la Turbo Moka da 3 tazze\"\n          >\n            Scopri la 3 tazze →\n          </a>\n        </div>\n      </article>\n    {% endif %}\n\n    {% if turbo_6 != blank %}\n      <article class=\"tm-choice__card\">\n        <h3>\n          <a href=\"{{ turbo_6.url }}\">Turbo Moka – 6 tazze</a>\n        </h3>\n\n        <p class=\"tm-choice__description\">\n          Pensata per preparare più caffè, per la famiglia o quando ci\n          sono ospiti.\n        </p>\n\n        <div class=\"tm-choice__bottom\">\n          <div class=\"tm-choice__price\">\n            {% if turbo_6.compare_at_price_max > turbo_6.price %}\n              <span class=\"tm-choice__old-price\">\n                {{ turbo_6.compare_at_price_max | money_with_currency }}\n              </span>\n            {% endif %}\n            <strong>{{ turbo_6.price | money_with_currency }}</strong>\n          </div>\n\n          <p class=\"tm-choice__availability\">\n            {% if turbo_6.available %}\n              <span class=\"tm-choice__available\">Disponibile</span>\n            {% else %}\n              <span class=\"tm-choice__unavailable\">Non disponibile</span>\n            {% endif %}\n          </p>\n\n          <a\n            class=\"tm-choice__link\"\n            href=\"{{ turbo_6.url }}\"\n            aria-label=\"Scopri la Turbo Moka da 6 tazze\"\n          >\n            Scopri la 6 tazze →\n          </a>\n        </div>\n      </article>\n    {% endif %}\n\n  </div>\n\n  <div class=\"tm-choice__desktop-comparison\">\n    <table class=\"tm-choice__table\">\n      <thead>\n        <tr>\n          <th scope=\"col\">Versione</th>\n          <th scope=\"col\">Ideale per</th>\n          <th scope=\"col\">Occasione d’uso</th>\n          <th scope=\"col\">Quantità</th>\n        </tr>\n      </thead>\n\n      <tbody>\n        <tr>\n          <th scope=\"row\">1 tazza</th>\n          <td>Un caffè individuale</td>\n          <td>Casa o ufficio</td>\n          <td>1 tazzina moka</td>\n        </tr>\n\n        <tr>\n          <th scope=\"row\">3 tazze</th>\n          <td>Uso quotidiano</td>\n          <td>Colazione o pausa caffè</td>\n          <td>3 tazzine moka</td>\n        </tr>\n\n        <tr>\n          <th scope=\"row\">6 tazze</th>\n          <td>Famiglia e ospiti</td>\n          <td>Più caffè nello stesso momento</td>\n          <td>6 tazzine moka</td>\n        </tr>\n      </tbody>\n    </table>\n  </div>\n\n  <p class=\"tm-choice__note\">\n    Le “tazze” indicano le tradizionali tazzine da moka e non necessariamente\n    il numero di persone servite.\n  </p>\n\n</section>\n\n<style>\n  .tm-choice {\n    width: 100%;\n    max-width: 1760px;\n    margin: 0 auto;\n    padding: 48px 44px;\n    box-sizing: border-box;\n  }\n\n  .tm-choice__header {\n    margin-bottom: 36px;\n  }\n\n  .tm-choice__header h2 {\n    margin: 0 0 14px;\n    font-size: clamp(32px, 3vw, 50px);\n    line-height: 1.15;\n    font-weight: 400;\n  }\n\n  .tm-choice__header p {\n    max-width: 1000px;\n    margin: 0;\n    font-size: 21px;\n    line-height: 1.55;\n  }\n\n  .tm-choice__cards {\n    display: grid;\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n    gap: 28px;\n    margin-bottom: 56px;\n  }\n\n  .tm-choice__card {\n    display: flex;\n    flex-direction: column;\n    min-height: 430px;\n    padding: 32px;\n    border: 1px solid rgba(0, 0, 0, 0.16);\n    border-radius: 20px;\n    background: #fff;\n    box-sizing: border-box;\n  }\n\n  .tm-choice__card--featured {\n    border-width: 2px;\n  }\n\n  .tm-choice__badge {\n    align-self: flex-start;\n    margin-bottom: 18px;\n    padding: 7px 14px;\n    border-radius: 999px;\n    background: #f3ca4c;\n    font-size: 14px;\n    line-height: 1.2;\n    font-weight: 700;\n  }\n\n  .tm-choice__card h3 {\n    margin: 0 0 20px;\n    font-size: 30px;\n    line-height: 1.25;\n    font-weight: 400;\n  }\n\n  .tm-choice__card h3 a {\n    color: inherit;\n    text-decoration: none;\n  }\n\n  .tm-choice__card h3 a:hover {\n    text-decoration: underline;\n    text-underline-offset: 4px;\n  }\n\n  .tm-choice__description {\n    margin: 0 0 30px;\n    font-size: 20px;\n    line-height: 1.65;\n  }\n\n  .tm-choice__bottom {\n    margin-top: auto;\n  }\n\n  .tm-choice__price {\n    display: flex;\n    align-items: baseline;\n    flex-wrap: wrap;\n    gap: 10px;\n    font-size: 28px;\n  }\n\n  .tm-choice__old-price {\n    font-size: 16px;\n    text-decoration: line-through;\n    opacity: 0.65;\n  }\n\n  .tm-choice__availability {\n    margin: 14px 0 24px;\n    font-size: 18px;\n  }\n\n  .tm-choice__available {\n    color: #16813d;\n  }\n\n  .tm-choice__unavailable {\n    color: #a22525;\n  }\n\n  .tm-choice__link {\n    display: inline-block;\n    color: inherit;\n    font-size: 18px;\n    font-weight: 700;\n    text-decoration-thickness: 1px;\n    text-underline-offset: 6px;\n  }\n\n  .tm-choice__desktop-comparison {\n    display: block;\n  }\n\n  .tm-choice__table {\n    width: 100%;\n    border-collapse: collapse;\n    table-layout: fixed;\n    text-align: center;\n  }\n\n  .tm-choice__table th,\n  .tm-choice__table td {\n    padding: 24px 18px;\n    border: 1px solid rgba(0, 0, 0, 0.17);\n    font-size: 18px;\n    line-height: 1.45;\n  }\n\n  .tm-choice__table thead th {\n    background: rgba(0, 0, 0, 0.025);\n    font-weight: 700;\n  }\n\n  .tm-choice__table thead th:first-child {\n    width: 14%;\n  }\n\n  .tm-choice__table thead th:nth-child(2) {\n    width: 27%;\n  }\n\n  .tm-choice__table thead th:nth-child(3) {\n    width: 39%;\n  }\n\n  .tm-choice__table thead th:last-child {\n    width: 20%;\n  }\n\n  .tm-choice__table tbody th {\n    font-weight: 700;\n  }\n\n  .tm-choice__note {\n    margin: 16px 0 0;\n    font-size: 15px;\n    line-height: 1.55;\n    opacity: 0.72;\n  }\n\n  @media screen and (max-width: 989px) {\n    .tm-choice {\n      padding: 42px 24px;\n    }\n\n    .tm-choice__cards {\n      grid-template-columns: 1fr;\n      gap: 20px;\n      margin-bottom: 38px;\n    }\n\n    .tm-choice__card {\n      min-height: auto;\n    }\n  }\n\n  @media screen and (max-width: 749px) {\n    .tm-choice {\n      padding: 34px 16px;\n    }\n\n    .tm-choice__header {\n      margin-bottom: 26px;\n    }\n\n    .tm-choice__header h2 {\n      font-size: 32px;\n    }\n\n    .tm-choice__header p {\n      font-size: 17px;\n      line-height: 1.55;\n    }\n\n    .tm-choice__cards {\n      margin-bottom: 18px;\n    }\n\n    .tm-choice__card {\n      padding: 24px 20px;\n      border-radius: 16px;\n    }\n\n    .tm-choice__card h3 {\n      font-size: 24px;\n    }\n\n    .tm-choice__description {\n      font-size: 17px;\n      line-height: 1.55;\n    }\n\n    .tm-choice__price {\n      font-size: 24px;\n    }\n\n    .tm-choice__availability,\n    .tm-choice__link {\n      font-size: 16px;\n    }\n\n    .tm-choice__desktop-comparison {\n      display: none;\n    }\n\n    .tm-choice__note {\n      margin-top: 16px;\n      font-size: 13px;\n    }",
